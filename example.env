# OLX Config
# Default administrator: configure these before starting the server.
# This account can create regular user accounts at /users.
# Choose a unique 12–256 character password and a random secret (32+ characters).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

SEARCH_URL_SELECTOR='[data-testid="l-card"] a[href]'
# Exclude the next/previous controls: the scraper reads the last numbered link.
LAST_PAGE_SELECTOR='[data-testid="pagination-wrapper"] a[href*="page="]:not([data-testid="pagination-forward"]):not([data-testid="pagination-backward"])'

APARTMENT_TITLE_SELECTOR="title"
APARTMENT_PRICE_SELECTOR="div[data-testid='ad-price-container'] .css-90xrc0"
APARTMENT_DESCRIPTION_SELECTOR='div[data-cy="ad_description"] .css-1t507yq'
APARTMENT_RENT_SELECTOR=".css-1r0si1e p.css-b5m1rv"
APARTMENT_IMAGES_SELECTOR="div[data-cy='adPhotos-swiperSlide'] img"
